APP_NAME="Okuma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=okuma
DB_USERNAME=okuma_user
DB_PASSWORD=change_me_strong_password_123!
DB_ROOT_PASSWORD=change_me_root_password_456!

# ── Cache / Queue / Session ───────────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# ── Redis (optional – uncomment when adding Redis service) ───────────────────
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@okuma.local"
MAIL_FROM_NAME="${APP_NAME}"

# ── Filesystem ────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
BCRYPT_ROUNDS=12

# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_HOST=localhost
HTTP_PORT=8000
PMA_PORT=8080

# ── Port forwarding (local dev only) ──────────────────────────────────────────
FORWARD_DB_PORT=127.0.0.1:3306

# ── Migrations (set false to skip auto-migration on container start) ──────────
RUN_MIGRATIONS=true

# ── AWS (leave empty unless using S3) ────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
